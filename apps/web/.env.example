# Copy to .env.local and fill in. All values are read at Next.js build time;
# restart `next dev` (or rebuild the docker `web` image) after changes.

# logo.dev publishable key — drives merchant + repo-link logo fetching.
# Get one free at https://logo.dev (the `pk_` prefix means it's safe to expose
# in client bundles). Without a token, logos render as letter / placeholder marks.
NEXT_PUBLIC_LOGO_DEV_TOKEN=pk_your_token_here

# Set to 1 on the public demo deployment to show a welcome dialog with intro
# text and repo links on first visit. Leave blank for personal deploys.
NEXT_PUBLIC_DEMO_MODE=

# Fava slugifies the journal title for the URL prefix; the web app proxies
# /api/fava/* and /api/ext/* to /<slug>/... on the fava server. Must match
# your journal's `option "title"` after slugify. Default in next.config.mjs is
# `acme-demo` (matches the public demo ledger). Override here to point local
# dev at a different ledger.
# FAVA_LEDGER_SLUG=acme-demo
