# Copy to .env (or .env.local) and fill in. All values are read at Next.js
# build time; restart `next dev` (or rebuild the docker `web` image) after
# changes — nothing here is picked up at runtime.
#
# Only web-app-specific values belong here. FAVA_LEDGER_SLUG and
# FAVA_INTERNAL_URL live in the repo-root `.env` instead: the Justfile loads it
# (`set dotenv-load`) and exports it to every recipe, so the web proxy and the
# Chrome extension build read a single value. See ../../.env.example.
# Launch via `just web-dev` / `just web-build` so that export happens.

# logo.dev publishable key — drives merchant + repo-link logo fetching.
# Get one free at https://logo.dev (the `pk_` prefix means it's safe to expose
# in client bundles). Without a token, logos render as letter / placeholder marks.
NEXT_PUBLIC_LOGO_DEV_TOKEN=pk_your_token_here

# Set to 1 on the public demo deployment to show a welcome dialog with intro
# text and repo links on first visit. Leave blank for personal deploys.
# Truthy = any value other than empty, "0", or "false".
NEXT_PUBLIC_DEMO_MODE=

# Browser-tab title. SSR can't read the per-request /ui-config payload, so the
# page-title metadata bakes this at build time. Keep it in sync with
# `branding.title` in <LEDGER_DIR>/config/ui.yaml, which drives the in-app
# sidebar header. Defaults to "Ledger" when unset.
# NEXT_PUBLIC_APP_TITLE=My Ledger
