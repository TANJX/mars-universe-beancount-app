# Copy to deploy/.env and fill in. The real .env is gitignored.

# --- gitsync ---------------------------------------------------------------
# Ledger repo to mirror onto the shared volume. Point this at a data repo
# containing your beancount journal. Default is the public demo ledger; swap
# in your own (private) repo for a personal deployment.
GIT_REPO_URL=https://github.com/TANJX/mars-universe-beancount-demo.git
GIT_BRANCH=main
# Fine-grained PAT with `contents: read`. Required for private repos.
GIT_PAT=
# Poll interval in seconds. 300 = 5 min.
GIT_PULL_INTERVAL=300

# --- ledger -----------------------------------------------------------------
# Path to the journal entry point inside the cloned volume, relative to /repo.
# Defaults to journal/journal.beancount (matches the post-split data repo layout).
LEDGER_FILE_REL=journal/journal.beancount
# Fava slugifies the journal title and uses it as the URL prefix. The web app
# proxies API requests to /<slug>/api/...; this must match Fava's actual slug.
# Default `ledger` matches a journal with title "Ledger".
FAVA_LEDGER_SLUG=ledger

# --- web app ---------------------------------------------------------------
# Set to 1 on the public demo deployment to show a welcome dialog with intro
# text and repo links on first visit. Leave blank for personal deploys.
# Build-time only — Next.js inlines NEXT_PUBLIC_* values into the client bundle,
# so changing this requires `docker compose build web`.
NEXT_PUBLIC_DEMO_MODE=

# logo.dev publishable key (`pk_…`). Drives merchant + repo-link logos.
# Get one free at https://logo.dev. Without it, logos render as letter marks.
# Build-time only — same rebuild caveat as above.
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# --- ports (host side) -----------------------------------------------------
# Only `web` is exposed. Override to bind to your ZeroTier IP, e.g.
#   WEB_BIND=10.147.x.y:3000
WEB_BIND=3000
