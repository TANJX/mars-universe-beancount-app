<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mars-universe.web</string>

  <!-- Runs the standalone bundle release-web.sh promoted to `current`, never the repo's .next/. -->
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{STATE_DIR}}/web/current/apps/web/server.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{STATE_DIR}}/web/current</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PORT</key>
    <string>{{WEB_PORT}}</string>
    <key>HOSTNAME</key>
    <string>127.0.0.1</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>{{LOG_DIR}}/web.log</string>
  <key>StandardErrorPath</key>
  <string>{{LOG_DIR}}/web.log</string>
</dict>
</plist>
