<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mars-universe.fava</string>

  <!-- Straight from the repo venv, not `uv run`, so launchd never triggers a resolve. -->
  <key>ProgramArguments</key>
  <array>
    <string>{{APP_DIR}}/.venv/bin/fava</string>
    <string>{{LEDGER_DIR}}/journal/journal.beancount</string>
    <string>-H</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>{{FAVA_PORT}}</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{APP_DIR}}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{APP_DIR}}/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>LEDGER_DIR</key>
    <string>{{LEDGER_DIR}}</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <!-- Interactive keeps ledger parsing off the throttled Background QoS tier. -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>{{LOG_DIR}}/fava.log</string>
  <key>StandardErrorPath</key>
  <string>{{LOG_DIR}}/fava.log</string>
</dict>
</plist>
