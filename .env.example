# Copy to `.env` at the repo root and fill in. The real `.env` is gitignored.
#
# The Justfile does `set dotenv-load`, so every value here is exported into the
# environment of every `just` recipe. That makes this the right home for
# anything more than one workspace needs — notably FAVA_LEDGER_SLUG, which both
# the web proxy and the Chrome extension bake in at build time.
#
# Caveat: only `just` loads this file. Running the underlying tool directly
# (`pnpm --filter web dev`, `pnpm --filter card-balance-browser-extension build`)
# bypasses it and falls back to the in-code defaults, which point at the public
# demo ledger. Prefer the `just` recipes.

# --- ledger data -----------------------------------------------------------
# Root of your ledger working copy. Expected layout inside:
#   journal/      the beancount ledger (journal.beancount is the entry point)
#   config/       extract.yaml, forecast.yaml, ui.yaml
#   statements/   bank CSV exports (input to `just extract`)
# Consumed by the Justfile (`just fava`, `just format`) and by
# beancount_tooling.paths. Defaults to `<repo>/data`, which does not exist in a
# fresh clone — set this to your ledger checkout.
LEDGER_DIR=/path/to/your-ledger

# --- fava URL prefix -------------------------------------------------------
# Fava slugifies the journal's `option "title"` and uses it as its URL prefix.
# Both consumers proxy through that prefix:
#   apps/web            /api/fava/* → /<slug>/api/*
#                       /api/ext/*  → /<slug>/extension/LedgerDataApi/*
#   chrome extension    fetches /<slug>/extension/LedgerDataApi/get_balance
# A mismatch shows up as a 404 served by Fava, not by Next. Both defaults are
# `acme-demo` (the public demo ledger) when this is unset.
#
# To find the real value, start `just fava` and watch where / redirects:
#   curl -sI http://127.0.0.1:5000/ | grep -i location
#
# Both consumers bake this at build time: changing it needs a `next dev`
# restart, a `just web-build`, and a `just build-extension`.
FAVA_LEDGER_SLUG=acme-demo

# --- fava host (optional) --------------------------------------------------
# Where apps/web sends proxied API requests. Defaults to http://127.0.0.1:5000,
# which matches a local `just fava`. The Docker stack overrides this to
# http://fava:5000 via a build arg; see deploy/.env.example.
# FAVA_INTERNAL_URL=http://127.0.0.1:5000
